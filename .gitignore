/ios/Runner/GeneratedPluginRegistrant.*

# Web build directories
/web/build/

# Linux build directories
/linux/build/

# Windows build directories
/windows/build/

# macOS build directories
/macos/build/

# Env files (do not commit secrets)
.env
.env.*
!*.example

# Google / Firebase credentials
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# Local development scripts
run_app.sh
quick_run.sh

